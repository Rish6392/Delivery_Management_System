// Prisma schema for Logistics, Fleet & Delivery Management Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  DISPATCHER
  DRIVER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum DriverCurrentStatus {
  AVAILABLE
  ASSIGNED
  ON_DELIVERY
  OFF_DUTY
}

enum VehicleType {
  VAN
  TRUCK
  MINI_TRUCK
  BIKE
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum VehicleCurrentStatus {
  AVAILABLE
  ASSIGNED
  IN_TRANSIT
  MAINTENANCE
}

enum ShipmentStatus {
  CREATED
  ASSIGNED
  PICKUP_CONFIRMED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RESCHEDULED
  CANCELLED
}

enum ShipmentPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
  FAILED
}

enum DeliveryEventType {
  CREATED
  ASSIGNED
  PICKUP_CONFIRMED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  RESCHEDULED
  CANCELLED
}

enum ProofStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─── Models ──────────────────────────────────────────────────────────

model User {
  id             String     @id @default(cuid())
  userId         String     @unique @map("user_id") // e.g. USR-001
  name           String
  email          String     @unique
  passwordHash   String     @map("password_hash")
  role           UserRole
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  // Relations
  customer       Customer?
  driver         Driver?
  auditLogs      AuditLog[]
  assignedBy     DriverAssignment[] @relation("AssignedByUser")

  @@map("users")
}

model Customer {
  id              String         @id @default(cuid())
  customerId      String         @unique @map("customer_id") // e.g. CUS-001
  customerNumber  String         @unique @map("customer_number") // e.g. CUST-001
  userId          String         @unique @map("user_id")
  name            String
  phone           String?
  email           String
  address         String?
  status          CustomerStatus @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  user            User           @relation(fields: [userId], references: [userId], onDelete: Cascade)
  shipments       Shipment[]

  @@map("customers")
}

model Driver {
  id              String              @id @default(cuid())
  driverId        String              @unique @map("driver_id") // e.g. DRV-001
  employeeNumber  String              @unique @map("employee_number")
  userId          String              @unique @map("user_id")
  name            String
  phone           String?
  licenseNumber   String              @unique @map("license_number")
  licenseExpiry   DateTime            @map("license_expiry")
  status          DriverStatus        @default(ACTIVE)
  currentStatus   DriverCurrentStatus @default(AVAILABLE) @map("current_status")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  user            User                @relation(fields: [userId], references: [userId], onDelete: Cascade)
  assignments     DriverAssignment[]
  deliveryEvents  DeliveryEvent[]
  proofOfDelivery ProofOfDelivery[]
  vehicles        Vehicle[]           @relation("CurrentDriver")

  @@map("drivers")
}

model Vehicle {
  id                  String              @id @default(cuid())
  vehicleId           String              @unique @map("vehicle_id") // e.g. VEH-001
  registrationNumber  String              @unique @map("registration_number")
  vehicleType         VehicleType         @map("vehicle_type")
  capacityKg          Float               @map("capacity_kg")
  status              VehicleStatus       @default(ACTIVE)
  currentStatus       VehicleCurrentStatus @default(AVAILABLE) @map("current_status")
  currentDriverId     String?             @map("current_driver_id")
  lastServiceDate     DateTime?           @map("last_service_date")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  // Relations
  currentDriver       Driver?             @relation("CurrentDriver", fields: [currentDriverId], references: [driverId])
  assignments         DriverAssignment[]

  @@map("vehicles")
}

model Shipment {
  id                    String          @id @default(cuid())
  shipmentId            String          @unique @map("shipment_id") // e.g. SHP-001
  shipmentNumber        String          @unique @map("shipment_number") // e.g. SHIP-00001
  customerId            String          @map("customer_id")
  pickupAddress         String          @map("pickup_address")
  deliveryAddress       String          @map("delivery_address")
  packageDescription    String?         @map("package_description")
  packageWeightKg       Float?          @map("package_weight_kg")
  priority              ShipmentPriority @default(NORMAL)
  scheduledPickupDate   DateTime?       @map("scheduled_pickup_date")
  scheduledDeliveryDate DateTime?       @map("scheduled_delivery_date")
  status                ShipmentStatus  @default(CREATED)
  cancellationReason    String?         @map("cancellation_reason")
  failureReason         String?         @map("failure_reason")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  // Relations
  customer              Customer        @relation(fields: [customerId], references: [customerId], onDelete: Restrict)
  assignments           DriverAssignment[]
  deliveryEvents        DeliveryEvent[]
  proofOfDelivery       ProofOfDelivery[]

  @@index([customerId])
  @@index([status])
  @@map("shipments")
}

model DriverAssignment {
  id            String           @id @default(cuid())
  assignmentId  String           @unique @map("assignment_id") // e.g. ASN-001
  shipmentId    String           @map("shipment_id")
  driverId      String           @map("driver_id")
  vehicleId     String           @map("vehicle_id")
  assignedById  String           @map("assigned_by")
  assignedAt    DateTime         @default(now()) @map("assigned_at")
  startedAt     DateTime?        @map("started_at")
  endedAt       DateTime?        @map("ended_at")
  status        AssignmentStatus @default(ACTIVE)
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  // Relations
  shipment      Shipment         @relation(fields: [shipmentId], references: [shipmentId], onDelete: Restrict)
  driver        Driver           @relation(fields: [driverId], references: [driverId], onDelete: Restrict)
  vehicle       Vehicle          @relation(fields: [vehicleId], references: [vehicleId], onDelete: Restrict)
  assignedBy    User             @relation("AssignedByUser", fields: [assignedById], references: [userId], onDelete: Restrict)

  // Prevent duplicate active assignments for same driver or vehicle
  @@index([driverId, status])
  @@index([vehicleId, status])
  @@index([shipmentId, status])
  @@map("driver_assignments")
}

model DeliveryEvent {
  id              String            @id @default(cuid())
  eventId         String            @unique @map("event_id") // e.g. EVT-001
  shipmentId      String            @map("shipment_id")
  driverId        String?           @map("driver_id")
  eventType       DeliveryEventType @map("event_type")
  location        String?
  notes           String?
  idempotencyKey  String            @unique @map("idempotency_key")
  createdAt       DateTime          @default(now()) @map("created_at")

  // Relations
  shipment        Shipment          @relation(fields: [shipmentId], references: [shipmentId], onDelete: Restrict)
  driver          Driver?           @relation(fields: [driverId], references: [driverId], onDelete: SetNull)

  @@index([shipmentId])
  @@index([idempotencyKey])
  @@map("delivery_events")
}

model ProofOfDelivery {
  id            String      @id @default(cuid())
  proofId       String      @unique @map("proof_id") // e.g. PRD-001
  shipmentId    String      @map("shipment_id")
  driverId      String      @map("driver_id")
  fileName      String      @map("file_name")
  fileUrl       String      @map("file_url")
  fileType      String      @map("file_type")
  fileSize      Int?        @map("file_size")
  status        ProofStatus @default(PENDING)
  uploadedAt    DateTime    @default(now()) @map("uploaded_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  // Relations
  shipment      Shipment    @relation(fields: [shipmentId], references: [shipmentId], onDelete: Restrict)
  driver        Driver      @relation(fields: [driverId], references: [driverId], onDelete: Restrict)

  @@index([shipmentId])
  @@map("proof_of_delivery")
}

model AuditLog {
  id          String   @id @default(cuid())
  auditId     String   @unique @map("audit_id") // e.g. AUD-001
  userId      String   @map("user_id")
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user        User     @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @unique
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  payload      Json?
  response     Json?
  statusCode   Int?     @map("status_code")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([key])
  @@map("idempotency_records")
}
